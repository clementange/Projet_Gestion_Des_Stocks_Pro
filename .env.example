# Copier en .env et renseigner. AUCUNE valeur de ce fichier n'est utilisable telle quelle :
# les secrets n'ont plus de valeur par defaut et le demarrage echoue s'ils sont absents
# (RequiredSecretsValidator) - voir docs/phase-5b2i-report.md.

# --- Base de donnees
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestionstock
DB_USERNAME=postgres
# Obligatoire. Aucun defaut.
DB_PASSWORD=

# --- JWT
# Obligatoire, 32 octets minimum (HS256). Generer par ex. : openssl rand -base64 48
# NE REUTILISEZ PAS l'ancienne cle par defaut du depot : elle est dans l'historique git et doit
# etre consideree comme compromise.
JWT_SECRET=

# --- MinIO (stockage des media)
MINIO_ENDPOINT=http://localhost:9000
# Obligatoires. Aucun defaut.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=gestiondestock-media

# --- Divers
SERVER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4200

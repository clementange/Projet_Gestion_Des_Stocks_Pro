<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 3c : mapping JPA hors annotations pour les modules deja traites (organization, puis
  catalog). Spring Boot n'auto-decouvre que le nom de fichier exact META-INF/orm.xml (verifie en
  Phase 3c/organization, sans spring.jpa.mapping-resources) : un seul fichier partage pour tous
  les modules plutot qu'un fichier par module, pour rester sur le mecanisme d'auto-decouverte deja
  valide sans en re-verifier un second.

  organization.domain.model (Organization/City/Site/Warehouse) : Organization et Site sont
  referencees via @ManyToOne depuis d'autres modules (catalog.Article/Category pour Organization ;
  sales.Sale/CustomerOrder, inventory.Stock/StockMovement, purchasing.PurchaseOrder,
  transfers.StockTransfer pour Site - voir docs/phase-3c-organization-report.md) : conserver
  EXACTEMENT le meme FQCN/package qu'aujourd'hui pour ces deux classes est donc obligatoire, pour
  ne toucher aucun des fichiers externes qui les referencent. City et Warehouse n'ont aucun
  consommateur externe mais sont mappees de la meme facon ici, par coherence.

  catalog.domain.model (Article/Category) : Article est referencee en @ManyToOne direct depuis
  inventory (Stock, StockMovement, InventoryFacadeImpl), purchasing (PurchaseOrderLine), sales
  (SaleLine, CustomerOrderLine), transfers (StockTransferLine), plus 4 entites legacy plates
  (LigneVente, LigneCommandeClient, LigneCommandeFournisseur, MvtStk) - meme contrainte
  FQCN/package qu'organization.Site, voir docs/phase-3c-catalog-report.md. Category n'a aucun
  consommateur externe (seul Article la reference, relation bidirectionnelle interne au module).

  identity.domain.model (Permission/Role/UserRoleAssignment) : aucun consommateur externe direct
  sur les trois (verifie avant d'ecrire ce mapping) - orm.xml applique quand meme par coherence
  avec les modules precedents. Role.permissions est un @ManyToMany avec @JoinTable (table de
  jointure role_permission, colonnes role_id/permission_id) - premiere relation de ce type dans ce
  fichier, voir docs/phase-3c-identity-report.md.

  inventory.domain.model (Stock/StockMovement) : contrairement a Organization/Site/Article,
  AUCUN consommateur externe direct sur ces deux classes (verifie) - orm.xml n'est donc pas ici
  une necessite technique mais un choix explicite de coherence avec les 3 modules precedents (voir
  docs/phase-3c-inventory-report.md). Stock porte deux nouveautes jamais rencontrees dans ce
  fichier : un @Version (seule entite de tout le schema a en porter un legitimement, voir
  V2__drop_stray_optimistic_lock_columns.sql) et une contrainte d'unicite composite sur
  (article_id, site_id). Stock porte aussi de vrais invariants metier (issue/receive/reserve/
  releaseReservation/correct) - aucune de ces methodes n'est annotee JPA, le deplacement des
  annotations de champ ne les touche pas ; un test unitaire pur golden-master
  (inventory/domain/model/StockTest, ecrit et verifie AVANT ce mapping) le garantit
  independamment des tests d'integration.

  Le mapped-superclass AbstractEntity (id/creationDate/lastModifiedDate) reste annote et inchange
  pour toutes les entites ci-dessous - non redeclare ici, herite normalement.
-->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                  version="3.1">

  <package>com.kfokam48.gestiondestock.organization.domain.model</package>

  <entity class="Organization" access="FIELD">
    <table name="organization"/>
    <attributes>
      <basic name="name">
        <column name="name" nullable="false"/>
      </basic>
      <basic name="description">
        <column name="description"/>
      </basic>
      <basic name="active">
        <column name="active" nullable="false"/>
      </basic>
      <basic name="email">
        <column name="email"/>
      </basic>
      <basic name="phone">
        <column name="phone"/>
      </basic>
      <basic name="website">
        <column name="website"/>
      </basic>
      <basic name="taxCode">
        <column name="tax_code"/>
      </basic>
      <basic name="photo">
        <column name="photo"/>
      </basic>
      <embedded name="adresse"/>
    </attributes>
  </entity>

  <entity class="City" access="FIELD">
    <table name="city"/>
    <attributes>
      <basic name="name">
        <column name="name" nullable="false"/>
      </basic>
      <basic name="country">
        <column name="country"/>
      </basic>
      <many-to-one name="organization">
        <join-column name="organization_id" nullable="false"/>
      </many-to-one>
    </attributes>
  </entity>

  <entity class="Site" access="FIELD">
    <table name="site"/>
    <attributes>
      <basic name="code">
        <column name="code" nullable="false" unique="true"/>
      </basic>
      <basic name="name">
        <column name="name" nullable="false"/>
      </basic>
      <basic name="type">
        <enumerated>STRING</enumerated>
        <column name="type" nullable="false"/>
      </basic>
      <embedded name="adresse"/>
      <basic name="active">
        <column name="active" nullable="false"/>
      </basic>
      <many-to-one name="city">
        <join-column name="city_id" nullable="false"/>
      </many-to-one>
    </attributes>
  </entity>

  <entity class="Warehouse" access="FIELD">
    <table name="warehouse"/>
    <attributes>
      <basic name="code">
        <column name="code" nullable="false" unique="true"/>
      </basic>
      <basic name="name">
        <column name="name" nullable="false"/>
      </basic>
      <basic name="description">
        <column name="description"/>
      </basic>
      <basic name="active">
        <column name="active" nullable="false"/>
      </basic>
      <one-to-one name="site">
        <join-column name="site_id" nullable="false" unique="true"/>
      </one-to-one>
    </attributes>
  </entity>

  <entity class="com.kfokam48.gestiondestock.catalog.domain.model.Category" access="FIELD">
    <table name="category"/>
    <attributes>
      <basic name="code">
        <column name="code"/>
      </basic>
      <basic name="designation">
        <column name="designation"/>
      </basic>
      <basic name="idEntreprise">
        <column name="identreprise"/>
      </basic>
      <many-to-one name="organization" target-entity="com.kfokam48.gestiondestock.organization.domain.model.Organization">
        <join-column name="organization_id"/>
      </many-to-one>
      <one-to-many name="articles" target-entity="com.kfokam48.gestiondestock.catalog.domain.model.Article" mapped-by="category"/>
    </attributes>
  </entity>

  <entity class="com.kfokam48.gestiondestock.catalog.domain.model.Article" access="FIELD">
    <table name="article"/>
    <attributes>
      <basic name="codeArticle">
        <column name="codearticle"/>
      </basic>
      <basic name="designation">
        <column name="designation"/>
      </basic>
      <basic name="prixUnitaireHt">
        <column name="prixunitaireht"/>
      </basic>
      <basic name="tauxTva">
        <column name="tauxtva"/>
      </basic>
      <basic name="prixUnitaireTtc">
        <column name="prixunitairettc"/>
      </basic>
      <basic name="photo">
        <column name="photo"/>
      </basic>
      <basic name="idEntreprise">
        <column name="identreprise"/>
      </basic>
      <many-to-one name="organization" target-entity="com.kfokam48.gestiondestock.organization.domain.model.Organization">
        <join-column name="organization_id"/>
      </many-to-one>
      <many-to-one name="category" target-entity="com.kfokam48.gestiondestock.catalog.domain.model.Category">
        <join-column name="idcategory"/>
      </many-to-one>
    </attributes>
  </entity>

  <entity class="com.kfokam48.gestiondestock.identity.domain.model.Permission" access="FIELD">
    <table name="permission"/>
    <attributes>
      <basic name="code">
        <column name="code" nullable="false" unique="true"/>
      </basic>
      <basic name="description">
        <column name="description"/>
      </basic>
    </attributes>
  </entity>

  <entity class="com.kfokam48.gestiondestock.identity.domain.model.Role" access="FIELD">
    <table name="role"/>
    <attributes>
      <basic name="code">
        <column name="code" nullable="false" unique="true"/>
      </basic>
      <basic name="name">
        <column name="name" nullable="false"/>
      </basic>
      <basic name="description">
        <column name="description"/>
      </basic>
      <many-to-many name="permissions" target-entity="com.kfokam48.gestiondestock.identity.domain.model.Permission" fetch="LAZY">
        <join-table name="role_permission">
          <join-column name="role_id"/>
          <inverse-join-column name="permission_id"/>
        </join-table>
      </many-to-many>
    </attributes>
  </entity>

  <entity class="com.kfokam48.gestiondestock.identity.domain.model.UserRoleAssignment" access="FIELD">
    <table name="user_role_assignment"/>
    <attributes>
      <basic name="userId">
        <column name="user_id" nullable="false"/>
      </basic>
      <many-to-one name="role" target-entity="com.kfokam48.gestiondestock.identity.domain.model.Role">
        <join-column name="role_id" nullable="false"/>
      </many-to-one>
      <basic name="scopeType">
        <enumerated>STRING</enumerated>
        <column name="scope_type" nullable="false"/>
      </basic>
      <basic name="scopeId">
        <column name="scope_id"/>
      </basic>
    </attributes>
  </entity>

  <entity class="com.kfokam48.gestiondestock.inventory.domain.model.StockMovement" access="FIELD">
    <table name="stock_movement"/>
    <attributes>
      <many-to-one name="article" target-entity="com.kfokam48.gestiondestock.catalog.domain.model.Article">
        <join-column name="article_id" nullable="false"/>
      </many-to-one>
      <many-to-one name="site" target-entity="com.kfokam48.gestiondestock.organization.domain.model.Site">
        <join-column name="site_id" nullable="false"/>
      </many-to-one>
      <basic name="dateMvt">
        <column name="date_mvt" nullable="false"/>
      </basic>
      <basic name="quantite">
        <column name="quantite" nullable="false"/>
      </basic>
      <basic name="type">
        <enumerated>STRING</enumerated>
        <column name="type" nullable="false"/>
      </basic>
      <basic name="source">
        <enumerated>STRING</enumerated>
        <column name="source" nullable="false"/>
      </basic>
      <basic name="reference">
        <column name="reference"/>
      </basic>
      <basic name="userId">
        <column name="user_id"/>
      </basic>
    </attributes>
  </entity>

  <entity class="com.kfokam48.gestiondestock.inventory.domain.model.Stock" access="FIELD">
    <table name="stock">
      <unique-constraint>
        <column-name>article_id</column-name>
        <column-name>site_id</column-name>
      </unique-constraint>
    </table>
    <attributes>
      <many-to-one name="article" target-entity="com.kfokam48.gestiondestock.catalog.domain.model.Article">
        <join-column name="article_id" nullable="false"/>
      </many-to-one>
      <many-to-one name="site" target-entity="com.kfokam48.gestiondestock.organization.domain.model.Site">
        <join-column name="site_id" nullable="false"/>
      </many-to-one>
      <basic name="quantitePhysique">
        <column name="quantite_physique" nullable="false"/>
      </basic>
      <basic name="quantiteReservee">
        <column name="quantite_reservee" nullable="false"/>
      </basic>
      <basic name="seuilAlerte">
        <column name="seuil_alerte"/>
      </basic>
      <version name="version">
        <column name="version"/>
      </version>
    </attributes>
  </entity>

</entity-mappings>
